# Copy to .env and adjust. Docker Compose reads this file automatically.
# Never commit the real .env — it is listed in .gitignore.

# --- PostgreSQL ---------------------------------------------------------
POSTGRES_DB=vodno
POSTGRES_USER=vodno
POSTGRES_PASSWORD=change-me-locally
POSTGRES_PORT=5432

# --- Backend ------------------------------------------------------------
APP_ENV=development
LOG_LEVEL=info
BACKEND_PORT=8000
# Comma-separated browser origins allowed to call the API.
CORS_ORIGINS=http://localhost:8080,http://localhost:5173
# Insert demo rides and reports the first time the database is empty.
SEED_DATA=true

# --- Frontend -----------------------------------------------------------
FRONTEND_PORT=8080

# --- Container images (used by CI and Kubernetes) -----------------------
IMAGE_REGISTRY=ghcr.io
IMAGE_NAMESPACE=vikishmiki
IMAGE_TAG=latest
