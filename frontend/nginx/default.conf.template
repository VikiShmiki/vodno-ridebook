# Rendered at container start by the nginx entrypoint, which runs envsubst over
# every file in /etc/nginx/templates. BACKEND_URL therefore stays configurable
# without rebuilding the image.

server {
    listen       8080;
    server_name  _;

    root  /usr/share/nginx/html;
    index index.html;

    gzip              on;
    gzip_types        text/css application/javascript application/json image/svg+xml;
    gzip_min_length   1024;

    # Never cache the entry document, so a rolling update is picked up on reload.
    location = /index.html {
        add_header Cache-Control "no-store";
    }

    # Hashed build assets are immutable.
    location /assets/ {
        add_header Cache-Control "public, max-age=31536000, immutable";
    }

    # Container-local liveness/readiness target that does not depend on the API.
    location = /healthz {
        access_log off;
        add_header Content-Type application/json;
        return 200 '{"status":"healthy"}';
    }

    # Docker Compose has no ingress controller, so nginx forwards API calls to
    # the backend service. In Kubernetes the Ingress matches /api first and this
    # block is never reached.
    location /api/ {
        proxy_pass         ${BACKEND_URL};
        proxy_http_version 1.1;
        proxy_set_header   Host              $host;
        proxy_set_header   X-Real-IP         $remote_addr;
        proxy_set_header   X-Forwarded-For   $proxy_add_x_forwarded_for;
        proxy_set_header   X-Forwarded-Proto $scheme;
        proxy_read_timeout 30s;
    }

    # Single page application fallback for client-side routes.
    location / {
        try_files $uri $uri/ /index.html;
    }
}
